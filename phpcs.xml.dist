<?xml version="1.0"?>
<ruleset name="Frizzly">
	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/languages/</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="ps"/>
	<rule ref="WordPress">
		<!--
		The plugin predates the class-*.php file naming convention. Complying means
		renaming all 40 files and rewriting every require_once; doing that inside a
		security release would bury the actual fixes in an unreviewable diff.
		Deferred to 1.2.0 - see TODO-1.2.0.md.
		-->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="4.7"/>
</ruleset>